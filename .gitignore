# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Platform build output (never commit)
android/build/
ios/build/

# Backend: only FogShield's own folder and its tests are tracked (the server
# copy is deployed from here). Everything else under app_services/ is a
# reference copy of other products — never commit.
# common/ holds DB credentials and Firebase service-account keys.
/app_services/*
!/app_services/fogshield/
!/app_services/fogshield_tests/
# Credentials live only in config.php (template: config.example.php).
/app_services/fogshield/config.php
/app_services/fogshield/logs/
/app_services/fogshield/backup_*/
/common/
