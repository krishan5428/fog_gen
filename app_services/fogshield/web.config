<?xml version="1.0" encoding="UTF-8"?>
<!--
  fogshield/web.config — IIS settings for this folder only.
  - No folder listing.
  - logs/ (user mobiles, emails), sql/ (DB scripts) and 4gcom_events.xml
    (read by the server only) are never served: IIS answers 404.
  The PHP endpoints are not affected. Rollback: delete this file.
-->
<configuration>
  <system.webServer>
    <directoryBrowse enabled="false" />
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="logs" />
          <add segment="sql" />
          <add segment="4gcom_events.xml" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
